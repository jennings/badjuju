{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VSCode: Build",
      "type": "shell",
      "command": "pnpm",
      "options": {
        "cwd": "${workspaceFolder}/clients/vscode"
      },
      "args": ["run", "build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "VSCode: Watch",
      "type": "shell",
      "command": "pnpm",
      "options": {
        "cwd": "${workspaceFolder}/clients/vscode"
      },
      "args": ["run", "watch"],
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    }
  ]
}
