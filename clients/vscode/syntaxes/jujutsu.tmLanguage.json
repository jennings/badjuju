{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Jujutsu VCS",
	"scopeName": "source.jujutsu",
	"patterns": [
		{ "include": "#jj-comment" },
		{ "include": "#section-header" },
		{ "include": "#file-status" },
		{ "include": "#empty-markers" },
		{ "include": "#bookmarks" },
		{ "include": "#commit-id" },
		{ "include": "#change-id" },
		{ "include": "#graph-chars" }
	],
	"repository": {
		"jj-comment": {
			"name": "comment.line.jj.jujutsu",
			"match": "^JJ:.*$"
		},
		"section-header": {
			"match": "^([A-Z][A-Z ]*):(.*)$",
			"captures": {
				"1": { "name": "keyword.other.section.jujutsu" },
				"2": { "name": "string.unquoted.revset.jujutsu" }
			}
		},
		"file-status": {
			"match": "^([AMDR]) ",
			"captures": {
				"1": { "name": "keyword.other.file-status.jujutsu" }
			}
		},
		"empty-markers": {
			"name": "comment.block.empty.jujutsu",
			"match": "\\((empty|no description set)\\)"
		},
		"bookmarks": {
			"name": "entity.name.tag.bookmark.jujutsu",
			"match": "\\[[^\\]\\n]+\\]"
		},
		"commit-id": {
			"name": "constant.numeric.commit-id.jujutsu",
			"match": "\\b[0-9][0-9a-f]{7,39}\\b"
		},
		"change-id": {
			"name": "constant.numeric.change-id.jujutsu",
			"match": "\\b[a-z]{8}\\b"
		},
		"graph-chars": {
			"name": "punctuation.section.graph.jujutsu",
			"match": "[│◆@~…○◉╭╮╯╰├─┤]"
		}
	}
}
