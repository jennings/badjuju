{
  "name": "badjuju-vcs",
  "displayName": "Bad Juju - Jujutsu VCS",
  "description": "Text-based version control client for Jujutsu (jj). Like Magit, but for jj.",
  "repository": "https://github.com/jennings/badjuju",
  "publisher": "turbocharged",
  "license": "MIT",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:jujutsu"
  ],
  "scripts": {
    "vscode:prepublish": "pnpm run build:prod",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "build:prod": "pnpm run build --minify",
    "watch": "pnpm run build --watch"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "^17.0.18",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0",
    "vscode-test": "^1.3.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "jujutsu",
        "aliases": [
          "Jujutsu VCS",
          "jujutsu"
        ],
        "extensions": [
          ".jujutsu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jujutsu",
        "scopeName": "source.jujutsu",
        "path": "./syntaxes/jujutsu.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Bad Juju",
      "properties": {
        "badjuju.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to jj binary. Leave blank to use jj on PATH."
        },
        "badjuju.defaultLogRevset": {
          "type": "string",
          "default": "",
          "description": "Default revset for badjuju.log.open. Leave blank to match the status window's stack: ancestors(reachable(@, mutable()), 2)."
        },
        "badjuju.keymapProfile": {
          "type": "string",
          "enum": ["magit", "none"],
          "default": "magit",
          "description": "Hotkey profile. 'magit' enables Magit-consensus bindings; 'none' disables all default hotkeys so you can define your own."
        }
      }
    },
    "commands": [
      {
        "command": "badjuju.status.open",
        "category": "jj",
        "title": "Status"
      },
      {
        "command": "badjuju.describe.open",
        "category": "jj",
        "title": "Describe working copy"
      },
      {
        "command": "badjuju.log.open",
        "category": "jj",
        "title": "Open log"
      },
      {
        "command": "badjuju.new.open",
        "category": "jj",
        "title": "New commit"
      },
      {
        "command": "badjuju.next.open",
        "category": "jj",
        "title": "Move working copy forward (jj next)"
      },
      {
        "command": "badjuju.next.edit",
        "category": "jj",
        "title": "Edit next change in place (jj next --edit)"
      },
      {
        "command": "badjuju.prev.open",
        "category": "jj",
        "title": "Move working copy back (jj prev)"
      },
      {
        "command": "badjuju.prev.edit",
        "category": "jj",
        "title": "Edit previous change in place (jj prev --edit)"
      },
      {
        "command": "badjuju.refresh.open",
        "category": "jj",
        "title": "Refresh"
      },
      {
        "command": "badjuju.log.applyShortcut",
        "category": "jj",
        "title": "Apply revset shortcut under cursor"
      },
      {
        "command": "badjuju.squash.file",
        "category": "jj",
        "title": "Squash file at cursor into parent"
      },
      {
        "command": "badjuju.unsquash.file",
        "category": "jj",
        "title": "Unsquash file at cursor from parent into child"
      },
      {
        "command": "badjuju.toggleStat.open",
        "category": "jj",
        "title": "Toggle --stat on the status window's stack log"
      },
      {
        "command": "badjuju.undo.open",
        "category": "jj",
        "title": "Undo last operation (jj undo)"
      },
      {
        "command": "badjuju.fetch.run",
        "category": "jj",
        "title": "Git fetch"
      },
      {
        "command": "badjuju.push.normal",
        "category": "jj",
        "title": "Git push"
      },
      {
        "command": "badjuju.push.forceWithLease",
        "category": "jj",
        "title": "Git push --force-with-lease"
      },
      {
        "command": "badjuju.edit.cursor",
        "category": "jj",
        "title": "Edit commit at cursor (move @)"
      },
      {
        "command": "badjuju.abandon.cursor",
        "category": "jj",
        "title": "Abandon commit at cursor (or working copy)"
      },
      {
        "command": "badjuju.diff.cursor",
        "category": "jj",
        "title": "Show diff for commit at cursor"
      },
      {
        "command": "badjuju.help.open",
        "category": "jj",
        "title": "Show hotkey help"
      },
      {
        "command": "badjuju.describe.finalize",
        "category": "jj",
        "title": "Finalize commit description (save and close)"
      },
      {
        "command": "badjuju.restartLanguageServer",
        "category": "jj",
        "title": "Restart Language Server"
      },
      {
        "command": "badjuju.version.open",
        "category": "jj",
        "title": "Show version"
      },
      {
        "command": "badjuju.rebase.prompt",
        "category": "jj",
        "title": "Rebase to destination"
      },
      {
        "command": "badjuju.bookmark.prompt",
        "category": "jj",
        "title": "Bookmark (create / move / delete / track / forget)"
      }
    ],
    "keybindings": [
      {
        "command": "badjuju.refresh.open",
        "key": "g",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.refresh.open",
        "key": "shift+r",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.new.open",
        "key": "n",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.next.open",
        "key": "ctrl+n",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.prev.open",
        "key": "ctrl+p",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.next.edit",
        "key": "ctrl+shift+n",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.prev.edit",
        "key": "ctrl+shift+p",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.log.open",
        "key": "l",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.fetch.run",
        "key": "f",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.push.normal",
        "key": "p",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.push.forceWithLease",
        "key": "shift+p",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.edit.cursor",
        "key": "e",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.bookmark.prompt",
        "key": "b",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.rebase.prompt",
        "key": "r",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.describe.open",
        "key": "d",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "key": "q",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.squash.file",
        "key": "s",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.undo.open",
        "key": "u",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.unsquash.file",
        "key": "shift+u",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus && !vim.active"
      },
      {
        "command": "badjuju.unsquash.file",
        "key": "ctrl+k u",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.toggleStat.open",
        "key": "=",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.log.applyShortcut",
        "key": "enter",
        "when": "badjuju.keymapsActive && badjuju.onLogShortcutLine && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus && !suggestWidgetVisible && !findWidgetVisible && !inSnippetMode"
      },
      {
        "command": "badjuju.abandon.cursor",
        "key": "a",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.abandon.cursor",
        "key": "a",
        "when": "badjuju.keymapsActive && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.edit.cursor",
        "key": "e",
        "when": "badjuju.keymapsActive && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.bookmark.prompt",
        "key": "b",
        "when": "badjuju.keymapsActive && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.rebase.prompt",
        "key": "r",
        "when": "badjuju.keymapsActive && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.describe.open",
        "key": "d",
        "when": "badjuju.keymapsActive && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.diff.cursor",
        "key": "shift+d",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.diff.cursor",
        "key": "shift+d",
        "when": "badjuju.keymapsActive && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.refresh.open",
        "key": "g",
        "when": "badjuju.keymapsActive && resourceFilename == 'diff.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.refresh.open",
        "key": "shift+r",
        "when": "badjuju.keymapsActive && resourceFilename == 'diff.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "key": "q",
        "when": "badjuju.keymapsActive && resourceFilename == 'diff.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.help.open",
        "key": "shift+/",
        "when": "badjuju.keymapsActive && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.help.open",
        "key": "shift+/",
        "when": "badjuju.keymapsActive && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.help.open",
        "key": "shift+/",
        "when": "badjuju.keymapsActive && resourceFilename == 'diff.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.refresh.open",
        "key": "g",
        "when": "badjuju.keymapsActive && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.refresh.open",
        "key": "shift+r",
        "when": "badjuju.keymapsActive && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "key": "q",
        "when": "badjuju.keymapsActive && resourceFilename == 'log.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.describe.finalize",
        "key": "ctrl+enter",
        "when": "badjuju.keymapsActive && resourceFilename == 'describe.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "workbench.action.revertAndCloseActiveEditor",
        "key": "escape escape",
        "when": "badjuju.keymapsActive && resourceFilename == 'describe.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.help.open",
        "key": "shift+/",
        "when": "badjuju.keymapsActive && resourceFilename == 'describe.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      }
    ]
  }
}
