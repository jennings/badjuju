{
  "name": "badjuju-vcs",
  "displayName": "Bad Juju - Jujutsu VCS",
  "description": "Text-based version control client for Jujutsu (jj). Like Magit, but for jj.",
  "repository": "https://github.com/jennings/badjuju",
  "publisher": "turbocharged",
  "license": "MIT",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:jujutsu"
  ],
  "scripts": {
    "vscode:prepublish": "pnpm run build:prod",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "build:prod": "pnpm run build --minify",
    "watch": "pnpm run build --watch",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test": "pnpm run compile-tests && vscode-test"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/mocha": "^10.0.10",
    "@types/node": "^17.0.18",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.25.0",
    "mocha": "^11.7.6",
    "typescript": "^5.0.0",
    "vscode-test": "^1.3.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "jujutsu",
        "aliases": [
          "Jujutsu VCS",
          "jujutsu"
        ],
        "extensions": [
          ".jujutsu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jujutsu",
        "scopeName": "source.jujutsu",
        "path": "./syntaxes/jujutsu.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Bad Juju",
      "properties": {
        "badjuju.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to jj binary. Leave blank to use jj on PATH."
        },
        "badjuju.defaultLogRevset": {
          "type": "string",
          "default": "",
          "description": "Default revset for badjuju.log.open. Leave blank to use the default: ancestors(mutable(), 2)."
        },
        "badjuju.keymapProfile": {
          "type": "string",
          "enum": [
            "magit",
            "vim",
            "none"
          ],
          "default": "magit",
          "description": "Hotkey profile. 'magit' enables Magit-consensus single-key bindings; 'vim' enables Fugitive-style two-letter verb chords; 'none' disables all default hotkeys so you can define your own."
        }
      }
    },
    "commands": [
      {
        "command": "badjuju.status.open",
        "category": "jj",
        "title": "Status"
      },
      {
        "command": "badjuju.describe.open",
        "category": "jj",
        "title": "Describe working copy"
      },
      {
        "command": "badjuju.log.open",
        "category": "jj",
        "title": "Open log"
      },
      {
        "command": "badjuju.log.prompt",
        "category": "jj",
        "title": "Open log with custom revset…"
      },
      {
        "command": "badjuju.new.open",
        "category": "jj",
        "title": "New commit"
      },
      {
        "command": "badjuju.next.open",
        "category": "jj",
        "title": "Move working copy forward (jj next)"
      },
      {
        "command": "badjuju.next.edit",
        "category": "jj",
        "title": "Edit next change in place (jj next --edit)"
      },
      {
        "command": "badjuju.prev.open",
        "category": "jj",
        "title": "Move working copy back (jj prev)"
      },
      {
        "command": "badjuju.prev.edit",
        "category": "jj",
        "title": "Edit previous change in place (jj prev --edit)"
      },
      {
        "command": "badjuju.refresh.open",
        "category": "jj",
        "title": "Refresh"
      },
      {
        "command": "badjuju.log.applyShortcut",
        "category": "jj",
        "title": "Apply revset shortcut under cursor"
      },
      {
        "command": "badjuju.squash.file",
        "category": "jj",
        "title": "Squash file at cursor into parent"
      },
      {
        "command": "badjuju.unsquash.file",
        "category": "jj",
        "title": "Unsquash file at cursor from parent into child"
      },
      {
        "command": "badjuju.squash.commit",
        "category": "jj",
        "title": "Select source or destination for commit-to-commit squash"
      },
      {
        "command": "badjuju.squash.cancel",
        "category": "jj",
        "title": "Cancel pending commit-to-commit squash"
      },
      {
        "command": "badjuju.squash.toggle",
        "category": "jj",
        "title": "Toggle hunk or file in squash window"
      },
      {
        "command": "badjuju.squash.select_all",
        "category": "jj",
        "title": "Select all changes for squash"
      },
      {
        "command": "badjuju.squash.select_none",
        "category": "jj",
        "title": "Deselect all changes for squash"
      },
      {
        "command": "badjuju.undo.open",
        "category": "jj",
        "title": "Undo last operation (jj undo)"
      },
      {
        "command": "badjuju.fetch.run",
        "category": "jj",
        "title": "Git fetch"
      },
      {
        "command": "badjuju.push.normal",
        "category": "jj",
        "title": "Git push"
      },
      {
        "command": "badjuju.push.forceWithLease",
        "category": "jj",
        "title": "Git push --force-with-lease"
      },
      {
        "command": "badjuju.edit.cursor",
        "category": "jj",
        "title": "Edit commit at cursor (move @)"
      },
      {
        "command": "badjuju.abandon.cursor",
        "category": "jj",
        "title": "Abandon commit at cursor (or working copy)"
      },
      {
        "command": "badjuju.diff.cursor",
        "category": "jj",
        "title": "Show change diff for commit at cursor (updates on amend)"
      },
      {
        "command": "badjuju.diff.cursor.commit",
        "category": "jj",
        "title": "Show commit diff for commit at cursor (pinned, immutable)"
      },
      {
        "command": "badjuju.help.open",
        "category": "jj",
        "title": "Show hotkey help"
      },
      {
        "command": "badjuju.describe.finalize",
        "category": "jj",
        "title": "Finalize commit description (save and close)"
      },
      {
        "command": "badjuju.restartLanguageServer",
        "category": "jj",
        "title": "Restart Language Server"
      },
      {
        "command": "badjuju.version.open",
        "category": "jj",
        "title": "Show version"
      },
      {
        "command": "badjuju.rebase.prompt",
        "category": "jj",
        "title": "Rebase to destination"
      },
      {
        "command": "badjuju.bookmark.prompt",
        "category": "jj",
        "title": "Bookmark (create / move / delete / track / forget)"
      }
    ],
    "keybindings": [
      {
        "command": "badjuju.refresh.open",
        "key": "shift+r",
        "when": "badjuju.keymapProfile == 'magit' && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.new.open",
        "key": "n",
        "when": "badjuju.keymapProfile == 'magit' && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.next.open",
        "key": "ctrl+n",
        "when": "badjuju.keymapProfile == 'magit' && resourceFilename == 'status.jujutsu' && resourceLangId == jujutsu && editorTextFocus"
