{
  "name": "vscode-badjuju-lsp",
  "displayName": "Bad Juju",
  "description": "Bad Juju Jujutsu VCS",
  "license": "MIT",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:jujutsu"
  ],
  "scripts": {
    "vscode:prepublish": "pnpm run build:prod",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "build:prod": "pnpm run build --minify",
    "watch": "pnpm run build --watch"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "^17.0.18",
    "@types/vscode": "1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0",
    "vscode-test": "^1.3.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "jujutsu",
        "aliases": [
          "Jujutsu VCS",
          "jujutsu"
        ],
        "extensions": [
          ".jj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jujutsu",
        "scopeName": "source.jujutsu",
        "path": "./syntaxes/jujutsu.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Bad Juju",
      "properties": {
        "badjuju.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to jj binary. Leave blank to use jj on PATH."
        },
        "badjuju.defaultLogRevset": {
          "type": "string",
          "default": "",
          "description": "Default revset for badjuju.log.open. Leave blank to use jj's default."
        }
      }
    },
    "commands": [
      {
        "command": "badjuju.status.open",
        "title": "Bad Juju: Open status window"
      },
      {
        "command": "badjuju.describe.open",
        "title": "Bad Juju: Describe working copy"
      },
      {
        "command": "badjuju.log.open",
        "title": "Bad Juju: Open log"
      },
      {
        "command": "badjuju.new",
        "title": "Bad Juju: New commit"
      },
      {
        "command": "badjuju.refresh",
        "title": "Bad Juju: Refresh"
      }
    ],
    "keybindings": [
      {
        "command": "badjuju.refresh",
        "key": "g",
        "when": "resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.refresh",
        "key": "r",
        "when": "resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.new",
        "key": "n",
        "when": "resourceFilename == status.jj && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.log.open",
        "key": "l",
        "when": "resourceFilename == status.jj && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "badjuju.describe.open",
        "key": "d",
        "when": "resourceFilename == status.jj && resourceLangId == jujutsu && editorTextFocus"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "key": "q",
        "when": "resourceFilename == status.jj && resourceLangId == jujutsu && editorTextFocus"
      }
    ]
  }
}
