{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "jujutsu",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_line"
      }
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "jj_comment"
        },
        {
          "type": "SYMBOL",
          "name": "section_header"
        },
        {
          "type": "SYMBOL",
          "name": "file_status_line"
        },
        {
          "type": "SYMBOL",
          "name": "_content_line"
        },
        {
          "type": "SYMBOL",
          "name": "_blank_line"
        }
      ]
    },
    "jj_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "JJ:[^\\n]*\\n?"
        }
      }
    },
    "section_header": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "header",
            "content": {
              "type": "SYMBOL",
              "name": "section_keyword"
            }
          },
          {
            "type": "FIELD",
            "name": "trailing",
            "content": {
              "type": "SYMBOL",
              "name": "section_trailing"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "\n"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "section_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[A-Z][A-Z ]*:"
        }
      }
    },
    "section_trailing": {
      "type": "PATTERN",
      "value": "[^\\n]*"
    },
    "file_status_line": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "file_status"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_content_atom"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "\n"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "file_status": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[AMDR] "
        }
      }
    },
    "_content_line": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_content_atom"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_content_atom"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "\n"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_blank_line": {
      "type": "STRING",
      "value": "\n"
    },
    "_content_atom": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "empty_marker"
        },
        {
          "type": "SYMBOL",
          "name": "bookmark"
        },
        {
          "type": "SYMBOL",
          "name": "_content_text"
        }
      ]
    },
    "empty_marker": {
      "type": "PATTERN",
      "value": "\\((empty|no description set)\\)"
    },
    "bookmark": {
      "type": "PATTERN",
      "value": "\\[[^\\]\\n]+\\]"
    },
    "_content_text": {
      "type": "PATTERN",
      "value": "[^\\x5b(\\n]+|\\(|\\["
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}